{
	"Mock.js boolean": {
		"scope": "json,jsonc",
		"prefix": "@boolean",
		"body": "@boolean",
		"description": "随机布尔值",
	},
	"Mock.js natural": {
		"scope": "json,jsonc",
		"prefix": "@natural",
		"body": "@natural(${1:0}, ${2:100})",
		"description": "随机自然数，参数：最小值、最大值",
	},
	"Mock.js integer": {
		"scope": "json,jsonc",
		"prefix": "@integer",
		"body": "@integer(${1:1}, ${2:100})",
		"description": "随机整数，参数：最小值、最大值",
	},
	"Mock.js float": {
		"scope": "json,jsonc",
		"prefix": "@float",
		"body": "@float(${1:0}, ${2:100}, ${3:2}, ${4:2})",
		"description": "随机浮点数，参数：整数最小值、整数最大值、小数位数下限、小数位数上限",
	},
	"Mock.js character": {
		"scope": "json,jsonc",
		"prefix": "@character",
		"body": "@character('${1:lower}')",
		"description": "随机字符，字符池可用 lower、upper、number、symbol 或自定义字符串",
	},
	"Mock.js string": {
		"scope": "json,jsonc",
